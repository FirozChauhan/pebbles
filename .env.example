# Pebbles frontend — environment variables
# Copy this file to ".env" and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the client.

# Backend API base URL (used by the resume optimizer)
VITE_API_URL=http://localhost:8000

# Firebase web app config (Project settings → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
